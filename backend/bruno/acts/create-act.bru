meta {
  name: Create Act
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/acts
  body: json
  auth: none
}

body:json {
  {
    "playId": 1,
    "number": 1,
    "name": "Act I",
    "script": [
      { "lineNumber": 1, "text": "Who's there?" },
      { "lineNumber": 2, "text": "Nay, answer me. Stand and unfold yourself." }
    ]
  }
}
