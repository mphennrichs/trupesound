generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  id               Int     @id @default(1)
  appId            String  @unique
  storageEndpoint  String?
  storageAccessKey String?
  storageSecretKey String?
  localFolder      String?
}

model Play {
  id              Int       @id @default(autoincrement())
  title           String
  author          String
  status          String
  active          Boolean   @default(true)
  icon            Int?
  backgroundColor String?
  acts            Act[]
  createdAt       DateTime
  createdBy       Int?
  lastUpdatedAt   DateTime?
  lastUpdatedBy   Int?
}

model Sound {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  durationMs  Int      @default(0)
  url         String
  archived    Boolean  @default(false)
  createdAt   DateTime
}

model Act {
  id            Int       @id @default(autoincrement())
  playId        Int
  play          Play      @relation(fields: [playId], references: [id], onDelete: Cascade)
  number        Int
  name          String
  script        Json      @default("[]")
  cues          Json      @default("[]")
  createdAt     DateTime
  createdBy     Int?
  lastUpdatedAt DateTime?
  lastUpdatedBy Int?
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  createdAt     DateTime
  createdBy     Int?
  lastUpdatedAt DateTime?
  lastUpdatedBy Int?
}
